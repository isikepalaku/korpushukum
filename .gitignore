# ── Obsidian UI state (per-mesin, jangan di-sync) ──
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json

# ── OS junk ──
Thumbs.db
.DS_Store
desktop.ini

# ── Runtime memory provider (OpenViking) — JANGAN masuk repo ──
# OpenViking default storage.workspace = ./data relatif CWD. Jika server
# dijalankan dengan cwd di dalam vault, database runtime (sqlite/LMDB/vectordb)
# akan mendarat di sini dan merusak sync. workspace sudah diarahkan ke
# ~/.openviking/data; baris ini adalah jaring pengaman.
data/
.openviking.lock

# ── Artefak turunan (regenerable) ──
90-log/chunks.jsonl.gz

# ── Git ──
.git/

# ── Berkas bantuan runtime plugin Obsidian Git (dibuat ulang tiap load) ──
.obsidian/plugins/obsidian-git/obsidian_askpass.sh

# ── Python cache ──
__pycache__/
*.pyc

# ── Log / cache sementara ──
*.log
*.tmp



# Graphify intermediate cache
graphify-out/cache/
graphify-out/.graphify_*
